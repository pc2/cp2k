#CPQA DEPENDS input_bulk_B88_3.inp
@SET NREPX 1
@SET NREPY 1
@SET NREPZ 1

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME ./BASIS_OPT
    POTENTIAL_FILE_NAME ./POTENTIAL
    WFN_RESTART_FILE_NAME B88.wfn
    &MGRID
      CUTOFF 300
      REL_CUTOFF 50
    &END MGRID
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-16
   EPS_FILTER_MATRIX 0.0e0
    &END QS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 1
      SCF_GUESS RESTART
      &OT
         PRECONDITIONER FULL_ALL
      &END
      &PRINT
        &RESTART OFF
        &END
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
      &HF
        &SCREENING
          EPS_SCHWARZ 1.0E-9
          EPS_SCHWARZ_FORCES 1.0E-9
          SCREEN_ON_INITIAL_P T
          SCREEN_P_FORCES T
        &END
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE TRUNCATED
          CUTOFF_RADIUS 6
          T_C_G_DATA ./t_c_g.dat
        &END
        &MEMORY
          MAX_MEMORY  120000
          EPS_STORAGE_SCALING 0.1
        &END
        &LOAD_BALANCE
          NBINS 1
          BLOCK_SIZE 1
          &PRINT
            LOAD_BALANCE_INFO .TRUE.
          &END
        &END
      &END
    &END XC
  &END DFT
  &SUBSYS
    &TOPOLOGY
      MULTIPLE_UNIT_CELL ${NREPX} ${NREPY} ${NREPZ}
    &END
    &CELL
      ABC 4.084 4.084 4.084
      MULTIPLE_UNIT_CELL ${NREPX} ${NREPY} ${NREPZ}
    &END CELL
    &COORD
Li 0 0 0
Li 2.042 2.042 0
Li 2.042 0 2.042
Li 0 2.042 2.042
H 2.042 2.042 2.042
H 2.042 0 0
H 0 2.042 0
H 0 0 2.042
    &END COORD
    &KIND H
      BASIS_SET OPT1
      POTENTIAL ALL
    &END KIND
    &KIND Li
      BASIS_SET OPT1
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  PROJECT     LiH_bulk_3
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  TRACE .TRUE.
  TRACE_MASTER .TRUE.
&END GLOBAL
&MOTION
 &MD
   TEMPERATURE 300
   TIMESTEP 0.5
   STEPS    5
 &END
&END

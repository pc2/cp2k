&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT LiH_bulk_3
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME ./BASIS_OPT_ORIGINAL
    POTENTIAL_FILE_NAME ./POTENTIAL
    &MGRID
      CUTOFF 300
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &BASIS_MOLOPT_QUANTITIES
      &END BASIS_MOLOPT_QUANTITIES
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_FILTER_MATRIX 0.0e0
      EPS_PGF_ORB 1.0E-16
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 10
      SCF_GUESS ATOMIC
      &OT
        PRECONDITIONER FULL_ALL
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 10
      &END OUTER_SCF
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &BECKE88
        &END BECKE88
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.252 12.252 12.252
    &END CELL
    &TOPOLOGY
     COORD_FILE_FORMAT XYZ
     COORD_FILE_NAME n3/lih.xyz
    &END TOPOLOGY
    &KIND H
      BASIS_SET OPT2
      POTENTIAL ALL
    &END KIND
    &KIND Li
      BASIS_SET OPT2
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
